{
  "bsonType": "object",
  "required": ["file_id", "user_id", "selected_text", "prefix", "suffix", "start_offset", "end_offset", "comment", "status", "created_at", "updated_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "批注 ID，系统自动生成"
    },
    "file_id": {
      "bsonType": "string",
      "description": "关联 mm-files._id"
    },
    "user_id": {
      "bsonType": "string",
      "description": "创建批注的用户"
    },
    "selected_text": {
      "bsonType": "string",
      "description": "用户选中的原文（plainText 片段）"
    },
    "prefix": {
      "bsonType": "string",
      "description": "选中内容前面的上下文（32 字符）",
      "defaultValue": ""
    },
    "suffix": {
      "bsonType": "string",
      "description": "选中内容后面的上下文（32 字符）",
      "defaultValue": ""
    },
    "start_offset": {
      "bsonType": "int",
      "description": "选中文本在提纯纯文本 plainText 中的起始位置"
    },
    "end_offset": {
      "bsonType": "int",
      "description": "选中文本在 plainText 中的结束位置（开区间）"
    },
    "comment": {
      "bsonType": "string",
      "description": "批注内容"
    },
    "status": {
      "bsonType": "string",
      "description": "active 成功匹配原文 / orphaned 无法定位",
      "enum": ["active", "orphaned"],
      "defaultValue": "active"
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间，服务器时间，不可修改",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "每次修改批注或重定位后由服务端更新",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}

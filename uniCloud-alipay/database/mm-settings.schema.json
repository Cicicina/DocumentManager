{
  "bsonType": "object",
  "required": ["key", "account_enabled", "permission_enabled", "admin_user_id", "updated_by", "updated_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "配置文档 ID，系统自动生成"
    },
    "key": {
      "bsonType": "string",
      "description": "业务唯一键，全表仅一条 app_config",
      "defaultValue": "app_config"
    },
    "account_enabled": {
      "bsonType": "bool",
      "description": "账号功能开关，默认开启",
      "defaultValue": true
    },
    "permission_enabled": {
      "bsonType": "bool",
      "description": "权限功能开关，默认关闭；仅在账号开启时可开启",
      "defaultValue": false
    },
    "admin_user_id": {
      "bsonType": "string",
      "description": "权限开启时记录首个注册用户（管理员）",
      "defaultValue": ""
    },
    "updated_by": {
      "bsonType": "string",
      "description": "最近修改者，匿名模式下强制记 __anonymous__",
      "defaultValue": ""
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "服务器时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}

{
  "bsonType": "object",
  "required": ["chunk_id", "file_id", "user_id", "heading", "content", "keywords", "start_offset", "end_offset", "revision", "created_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "记录 ID，系统自动生成"
    },
    "chunk_id": {
      "bsonType": "string",
      "description": "分块唯一 ID，规则 {file_id}#{序号}（唯一索引）"
    },
    "file_id": {
      "bsonType": "string",
      "description": "关联 mm-files._id"
    },
    "user_id": {
      "bsonType": "string",
      "description": "所属用户，冗余便于权限过滤"
    },
    "heading": {
      "bsonType": "string",
      "description": "所属 Markdown 标题文本；无标题块为空",
      "defaultValue": ""
    },
    "content": {
      "bsonType": "string",
      "description": "提纯后的纯文本分块内容"
    },
    "keywords": {
      "bsonType": "array",
      "description": "标题词 + 高频实词（去停用词）",
      "items": {
        "bsonType": "string",
        "description": "关键词"
      },
      "defaultValue": []
    },
    "start_offset": {
      "bsonType": "int",
      "description": "相对全文提纯文本 plainText 的起始位置"
    },
    "end_offset": {
      "bsonType": "int",
      "description": "相对全文 plainText 的结束位置"
    },
    "revision": {
      "bsonType": "int",
      "description": "保存后的文件 version，用于识别陈旧索引"
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "服务器时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}

{
    "name" : "MarkdownManager",
    "appid" : "__UNI__4F86BA0",
    "description" : "应用描述",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    /* 5+App特有相关 */

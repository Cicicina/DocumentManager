                    "<uses-permission android:name=\"android.permission.RECEIVE_USER_PRESENT\"/>"
                ]
            },
            /* ios打包配置 */
            "ios" : {
                "UIBackgroundModes" : [ "audio" ]
            },
            /* SDK配置 */
            "sdkConfigs" : {
                "speech" : {
                    "ifly" : {}
                }
            },
            "orientation" : [ "portrait-primary" ]
        }
    },
    /* 快应用特有相关 */
    "quickapp" : {},
    /* 小程序特有相关 */
    "mp-weixin" : {
        "appid" : "",
        "setting" : {
            "urlCheck" : false
        },
        "usingComponents" : true
    },
    "uniCloud" : {
        /* H5 端调用云函数必须知道服务空间；缺此节点时 uniCloud 为默认空配置（getCurrentSpace() 返回 null），
           所有云对象调用在客户端即失败，表现为「一直提示请先登录」。
           spaceId 取自服务空间 ID；clientSecret 需在 uniCloud 控制台 → 服务空间 → 概览 → 客户端密钥 复制，
           或在 HBuilderX 中右键 uniCloud-alipay → 关联云服务空间，由工具自动写入。 */
        "provider" : "alipay",
        "spaceId" : "env-__SPACE_ID__",
        "clientSecret" : ""
    },
    "h5" : {
        "template" : "template.h5.html",
        "router" : {
            "mode" : "hash",
            "base" : "/mymarkdown/web/"
        }
    },
    "vueVersion" : "3"
}
